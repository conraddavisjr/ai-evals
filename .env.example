# Postgres (docker compose default)
DATABASE_URL=postgres://cafe:cafe@localhost:5434/cafe

# Model providers. All optional: the mock provider needs no keys.
# Direct providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Vercel AI Gateway (required for TypeSafe Jev: gateway:typesafe-ai/jev)
AI_GATEWAY_API_KEY=
# Open-weights via any OpenAI-compatible server (Ollama, vLLM, LM Studio)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama

# Safety: live model calls are refused unless this is set to "true"
CAFE_ALLOW_LIVE_MODELS=false

# Server
PORT=4747
