{
  "title": "Stardust config pack, contract 1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "http"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "default": "POST",
          "type": "string",
          "enum": ["POST", "PUT"]
        },
        "headers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "bodyTemplate": {},
        "responseMap": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string"
            },
            "outcomeMap": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "enum": ["served", "refused", "failed"]
              }
            },
            "reason": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "steps": {
              "type": "string"
            },
            "usd": {
              "type": "string"
            },
            "inputTokens": {
              "type": "string"
            },
            "outputTokens": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "required": ["outcome", "outcomeMap"]
        },
        "responseSchema": {
          "type": "string"
        },
        "timeoutMs": {
          "default": 120000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["kind", "url", "bodyTemplate", "responseMap"]
    },
    "datasets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gateReasons": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "questions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "instructions": {
                    "type": "string"
                  }
                },
                "required": ["id", "type", "instructions"]
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "const": "score"
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "criteria": {
                    "default": ["very poor", "poor", "acceptable", "good", "excellent"],
                    "minItems": 5,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["id", "type", "instructions"]
              }
            ]
          }
        },
        "defaults": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "max": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  }
                }
              }
            ]
          }
        },
        "maxOutputChars": {
          "default": 24000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["model", "questions"]
    },
    "thresholds": {
      "default": {
        "byTag": {}
      },
      "type": "object",
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "byTag": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "budget": {
      "default": {},
      "type": "object",
      "properties": {
        "maxUsdPerRun": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "repeats": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["contract", "name", "target", "datasets"]
}
