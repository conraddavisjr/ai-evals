{
  "title": "Evals Cafe golden dataset",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]+$"
          },
          "title": {
            "type": "string"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "expect": {
            "default": {
              "assertions": []
            },
            "type": "object",
            "properties": {
              "outcome": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["served", "refused", "failed"]
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["served", "refused", "failed"]
                    }
                  }
                ]
              },
              "reason": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assertions": {
                "default": [],
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "jsonPath"
                        },
                        "path": {
                          "type": "string"
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "equals",
                            "notEquals",
                            "includes",
                            "excludes",
                            "lte",
                            "gte",
                            "exists",
                            "absent"
                          ]
                        },
                        "value": {},
                        "note": {
                          "type": "string"
                        },
                        "when": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["served", "refused", "failed"]
                          }
                        }
                      },
                      "required": ["type", "path", "op"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "count"
                        },
                        "path": {
                          "type": "string"
                        },
                        "min": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "note": {
                          "type": "string"
                        },
                        "when": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["served", "refused", "failed"]
                          }
                        }
                      },
                      "required": ["type", "path"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["regexAbsent", "regexPresent"]
                        },
                        "pattern": {
                          "type": "string"
                        },
                        "flags": {
                          "default": "i",
                          "type": "string"
                        },
                        "path": {
                          "default": "$.output",
                          "type": "string"
                        },
                        "note": {
                          "type": "string"
                        },
                        "when": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["served", "refused", "failed"]
                          }
                        }
                      },
                      "required": ["type", "pattern"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "stepPresent"
                        },
                        "name": {
                          "type": "string"
                        },
                        "note": {
                          "type": "string"
                        },
                        "when": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["served", "refused", "failed"]
                          }
                        }
                      },
                      "required": ["type", "name"]
                    }
                  ]
                }
              }
            }
          },
          "rubric": {
            "type": "string"
          },
          "judge": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "max": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 5
                    }
                  }
                }
              ]
            }
          },
          "skipJudge": {
            "default": false,
            "type": "boolean"
          },
          "smoke": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": ["id", "title", "input"]
      }
    }
  },
  "required": ["name", "cases"]
}
